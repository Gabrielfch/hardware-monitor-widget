<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SensorHost</AssemblyName>
    <RootNamespace>SensorHost</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <StartupHookSupport>false</StartupHookSupport>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Mono.Posix native helpers are only used on Linux/macOS; do not ship them on Windows. -->
  <Target Name="DropMonoPosixHelpers" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libMonoPosixHelper.dll' Or '%(Filename)%(Extension)' == 'MonoPosixHelper.dll'" />
    </ItemGroup>
  </Target>

</Project>
